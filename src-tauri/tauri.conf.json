{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cartera-tracker",
  "version": "0.1.0",
  "identifier": "ar.jeremias.carteratracker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cartera Tracker",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
